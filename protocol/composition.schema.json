{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musiccraft.invalid/protocol/composition.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "MusicCraft-Composition-Plan"
    },
    "version": {
      "const": "0.3"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_analysis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "imitation",
            "revision",
            "new"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "instructions"
      ],
      "additionalProperties": false
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "staff": {
            "enum": [
              1,
              2
            ]
          },
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        },
        "required": [
          "id",
          "staff",
          "channel"
        ],
        "additionalProperties": false
      }
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "start_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "length_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "meter": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "partial_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "number",
          "start_q",
          "length_q",
          "meter"
        ],
        "additionalProperties": false
      }
    },
    "tempos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "per_minute": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "reference_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "at_q",
          "per_minute",
          "reference_q"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "voice_id": {
            "type": "string",
            "minLength": 1
          },
          "pitch_midi": {
            "type": "integer",
            "minimum": 21,
            "maximum": 108
          },
          "onset_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "duration_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "velocity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 127
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "spelling": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "object",
            "properties": {
              "onset_s": {
                "type": "number",
                "minimum": 0
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "onset_s",
              "duration_s"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "voice_id",
          "pitch_midi",
          "onset_q",
          "duration_q",
          "velocity",
          "decision_id"
        ],
        "additionalProperties": false
      }
    },
    "rests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "voice_id": {
            "type": "string",
            "minLength": 1
          },
          "onset_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "duration_q": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "voice_id",
          "onset_q",
          "duration_q"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "enum": [
              "retained",
              "interpretation",
              "addition"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "finding_ids",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "plan_id",
    "revision",
    "title",
    "source_analysis",
    "request",
    "voices",
    "bars",
    "tempos",
    "notes",
    "rests",
    "decisions"
  ],
  "additionalProperties": false
}
